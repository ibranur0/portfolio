# Sikkerhetshoder for Cloudflare Pages.
# Resten av CSP-en står i <meta> på hver side, fordi SQL-lab og Strømsmart må hente fra andre domener.
# X-Robots-Tag gjør at siden ikke vises i søk. Den skal bare finnes via lenken.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex

# Fontene endres aldri, så de kan ligge i nettleserens hurtigbuffer lenge.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
